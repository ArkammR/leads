# Twilio (WhatsApp or SMS). TWILIO_FROM: "whatsapp:+14155238886" for WhatsApp, "+15551234567" for SMS
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Shared secret the 3PL partner sends in the x-webhook-secret header
WEBHOOK_SECRET=
# Phone numbers typed in local format (077...) are saved with this country code (94 = Sri Lanka)
DEFAULT_COUNTRY_CODE=94
# Public address of the web app, used for the Facebook sign-in redirect (e.g. https://your-project.web.app)
PUBLIC_BASE_URL=
# Meta app for Facebook/Instagram Lead Ads and WhatsApp Cloud API (developers.facebook.com > My Apps)
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value into Meta App Dashboard > Webhooks > Verify token
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
